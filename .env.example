# Elastic Serverless — see "Elastic Serverless Setup Guide" in PROJECT_BRIEF.md for how to obtain these
# ELASTIC_CLOUD_ID may be your Cloud ID (name:base64…) OR the cluster HTTPS URL from the Elastic Cloud UI
ELASTIC_CLOUD_ID=your-cloud-id
ELASTIC_API_KEY=your-api-key

# Kibana base URL (same Serverless project as Elasticsearch).
# If ELASTIC_CLOUD_ID is an HTTPS URL, build Kibana URL by replacing ".es." with ".kb." in the hostname
# (Elasticsearch → Kibana). Example:
#   https://my-deployment.es.us-central1.gcp.elastic.cloud:443
#   → https://my-deployment.kb.us-central1.gcp.elastic.cloud
# Used for Elastic Workflows (authoring + execution in Kibana), Agent Builder, etc.
# Often the same origin you use for AGENT_BUILDER_URL below (without :443 if omitted).
KIBANA_URL=

# Optional: dedicated key for Kibana/Workflow HTTP APIs if your ES key lacks Kibana privileges (uncommon on Serverless).
# If unset, server code may fall back to ELASTIC_API_KEY for Workflow/agent HTTP calls.
# KIBANA_API_KEY=
# Elastic Workflow ID for post-ingest real-time orchestration (manual trigger).
# Get from the Kibana Workflows UI → your workflow → copy the ID from the URL or workflow list.
# When set, the server calls POST {KIBANA_URL}/api/workflows/workflow/{id}/run after each note ingest.
# Leave unset to skip workflow invocation (drafter still runs locally via Agent Builder).
# KIBANA_WORKFLOW_ID=
# Granola (optional for local scripts; per-user keys are stored in Elastic — see Settings)
# GRANOLA_API_BASE=https://public-api.granola.ai
# GRANOLA_API_KEY=grn_...
# Local Google Drive path — see "Google Drive for Desktop Setup" in PROJECT_BRIEF.md
DRIVE_NOTES_PATH=/Users/you/Library/CloudStorage/GoogleDrive-you@company.com/Shared drives/Account Teams
# Jina AI API key — for Elastic Inference Service (EIS) endpoints
# Get from: https://jina.ai/api-key
# Optional: if not set, EIS endpoints will be skipped and BM25+ELSER fallback is used
JINA_API_KEY=
# Elastic Agent Builder (same Serverless project — typically KIBANA_URL without a path; often same host as Kibana)
AGENT_BUILDER_URL=
# Often same value as ELASTIC_API_KEY on Serverless for local demos
AGENT_BUILDER_API_KEY=
# Agent ID used by the Follow-up Drafter (POST /api/agent_builder/converse). Defaults to elastic-ai-agent.
# AGENT_BUILDER_DRAFTER_AGENT_ID=elastic-ai-agent
# Agent ID used by the Chat page. Defaults to account-intelligence-agent.
# AGENT_BUILDER_CHAT_AGENT_ID=account-intelligence-agent

# --- Multi-user auth (Phase 1) ---
# Google OIDC client (create at https://console.cloud.google.com/apis/credentials → "OAuth client ID" → Web application).
# Authorized redirect URI must match GOOGLE_OIDC_REDIRECT_URI exactly.
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
GOOGLE_OIDC_REDIRECT_URI=http://localhost:3001/auth/google/callback
# Lock sign-in to one Google Workspace domain (e.g. yourcompany.com). Comma-separated for multiple.
ALLOWED_HD=
# Where the SPA lives — used to redirect back after login and to lock CORS in multi-user mode.
APP_ORIGIN=http://localhost:5173
# Secret for signing the session cookie. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
# Comma-separated emails that bypass scope filters (admin role). Optional.
ADMIN_EMAILS=
# Master key for encrypting per-user Granola API keys at rest (32 bytes base64). Generate with the same command as SESSION_SECRET.
MASTER_ENCRYPTION_KEY=
# Set to "true" to enable multi-user enforcement (requireUser middleware, scope filters, encrypted keys).
# Leave unset/false during local dev to keep the legacy single-user flow working.
MULTI_USER=false

# --- Demo auth (MVP / stakeholder demos without Google OAuth) ---
# When MULTI_USER=true, set AUTH_MODE=demo to use a shared PIN + allowlisted emails
# instead of Google OIDC. Scope filters and encrypted Granola keys behave the same.
# GOOGLE_OIDC_* vars are not required in demo mode. Use HTTPS + a strong PIN on any shared host.
# AUTH_MODE=demo
# DEMO_AUTH_PIN=change-me-16chars
# Leave DEMO_AUTH_EMAILS unset to allow every persona in src/server/demo/demo-personas.ts,
# or set a comma-separated subset (must match that roster).
# DEMO_AUTH_EMAILS=steve.leung@elastic.co,ed.salazar@elastic.co

# Drive sidecar (per-account Markdown copy of every note + Friday digests). The sidecar
# is a shared filesystem path; in multi-user mode it lets anyone with read access bypass
# pursuit-team visibility, so we disable it by default when MULTI_USER=true. Override:
#   DRIVE_SIDECAR_ENABLED=true   — force enable (only safe with per-user 0700 subdirs)
#   DRIVE_SIDECAR_ENABLED=false  — force disable (canonical store stays Elastic)
# Unset = follow MULTI_USER (off in multi-user mode, on in single-user).
# DRIVE_SIDECAR_ENABLED=
